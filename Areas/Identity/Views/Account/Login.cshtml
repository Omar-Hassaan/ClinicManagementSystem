@model LoginVM
@{ ViewData["Title"] = "Sign In"; }

<div class="auth-card">
    <div class="auth-logo">
        <div class="logo-circle">🏥</div>
        <h2>Welcome Back</h2>
        <p>Sign in to your account to continue</p>
    </div>

    <form asp-action="Login" asp-controller="Account" asp-area="Identity" method="post">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" style="margin-bottom:16px;">
                <span>⚠️</span>
                <div>
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@err.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <div class="form-group">
            <label class="form-label">Email or Username</label>
            <input asp-for="EmailOrUsername" class="form-control" placeholder="Enter your email or username" autocomplete="username" />
            <span asp-validation-for="EmailOrUsername" class="field-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label" style="display:flex;justify-content:space-between;">
                Password
                <a href="#" style="font-size:13px;color:var(--primary);">Forgot password?</a>
            </label>
            <input asp-for="Password" class="form-control" placeholder="Enter your password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="form-check mb-4">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-label" style="margin:0;">Remember me</label>
        </div>

        <button type="submit" class="btn btn-primary w-full btn-lg">Sign In</button>

        <div class="auth-divider">or</div>

        <p style="text-align:center;font-size:14px;color:var(--muted);">
            Don't have an account?
            <a asp-action="Register" asp-controller="Account" asp-area="Identity" style="color:var(--primary);font-weight:600;">Create one</a>
        </p>
    </form>

    <div style="margin-top:20px;padding:14px;background:#f8fafc;border-radius:10px;font-size:12px;color:var(--muted);">
        <strong>Demo credentials:</strong><br/>
        Admin: superadmin / Admin@123
    </div>
</div>

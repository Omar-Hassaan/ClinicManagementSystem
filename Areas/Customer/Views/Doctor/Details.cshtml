@model Doctor
@{ ViewData["Title"] = "Dr. " + Model.FullName; ViewData["Page"] = "Doctors"; var schedules = ViewBag.Schedules as List<DoctorSchedule> ?? new(); }

<a asp-action="Index" class="btn btn-outline btn-sm mb-4">← Back to Doctors</a>

<div class="card mb-6">
    <div class="card-body flex items-center gap-4" style="flex-wrap:wrap;">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="avatar avatar-xl" />
        }
        else
        {
            <div class="avatar avatar-xl">@Model.FullName.Substring(0,1)</div>
        }
        <div style="flex:1;min-width:200px;">
            <h2 class="fw-700">Dr. @Model.FullName</h2>
            <p class="text-muted mt-1">@Model.Specialization</p>
            <p class="mt-1">🏥 @Model.Clinic?.Name · 📍 @Model.Clinic?.Address</p>
            <p class="mt-1 fw-600" style="color:var(--accent);">$@Model.ConsultationFee consultation fee</p>
        </div>
        <a asp-controller="Appointment" asp-action="Book" asp-route-doctorId="@Model.Id" class="btn btn-primary btn-lg">📅 Book Appointment</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Bio))
{
    <div class="card mb-6"><div class="card-header"><h5>About</h5></div><div class="card-body"><p>@Model.Bio</p></div></div>
}

<div class="card">
    <div class="card-header"><h5>📅 Weekly Availability</h5></div>
    <div class="card-body">
        @if (!schedules.Any())
        {
            <p class="text-muted">No availability published yet for this doctor.</p>
        }
        else
        {
            <div class="grid grid-3">
                @foreach (var s in schedules)
                {
                    <div class="badge badge-info" style="padding:10px 14px;font-size:14px;justify-content:center;">
                        @s.DayOfWeek: @s.StartTime.ToString("h:mm tt") – @s.EndTime.ToString("h:mm tt")
                    </div>
                }
            </div>
        }
    </div>
</div>

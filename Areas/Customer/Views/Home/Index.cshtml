@{
    ViewData["Title"] = "Dashboard"; ViewData["Page"] = "Home";
    var patient = ViewBag.Patient as Patient;
    var next = ViewBag.NextAppointment as Appointment;
}

<h2 class="fw-700 mb-1">Welcome back, @patient?.ApplicationUser?.FullName 👋</h2>
<p class="text-muted mb-6">Here's what's happening with your care.</p>

<div class="grid grid-3 mb-6">
    <div class="stat-card">
        <div class="stat-icon blue">📋</div>
        <div class="stat-info"><div class="stat-value">@ViewBag.TotalAppointments</div><div class="stat-label">Total Appointments</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green">📅</div>
        <div class="stat-info"><div class="stat-value">@ViewBag.UpcomingCount</div><div class="stat-label">Upcoming</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon purple">📄</div>
        <div class="stat-info"><div class="stat-value">@ViewBag.RecordsCount</div><div class="stat-label">Medical Records</div></div>
    </div>
</div>

<div class="grid grid-2">
    <div class="card">
        <div class="card-header"><h5>📅 Next Appointment</h5></div>
        <div class="card-body">
            @if (next != null)
            {
                <h3 class="fw-700">Dr. @next.Doctor?.FullName</h3>
                <p class="text-muted mt-1">@next.Doctor?.Specialization · @next.Doctor?.Clinic?.Name</p>
                <p class="mt-3 fw-600">🕐 @next.AppointmentDate.ToString("dddd, MMM d, yyyy - h:mm tt")</p>
                <a asp-controller="Appointment" asp-action="Index" class="btn btn-outline btn-sm mt-3">View All Appointments</a>
            }
            else
            {
                <p class="text-muted">You don't have any upcoming appointments.</p>
                <a asp-controller="Doctor" asp-action="Index" class="btn btn-primary mt-3">Book an Appointment</a>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h5>⚡ Quick Actions</h5></div>
        <div class="card-body flex flex-col gap-2">
            <a asp-controller="Doctor" asp-action="Index" class="btn btn-outline" style="justify-content:flex-start;">🔍 Find a Doctor & Book</a>
            <a asp-controller="Appointment" asp-action="Index" class="btn btn-outline" style="justify-content:flex-start;">📋 My Appointments</a>
            <a asp-controller="MedicalRecord" asp-action="Index" class="btn btn-outline" style="justify-content:flex-start;">📄 Medical Records & Prescriptions</a>
            <a asp-controller="Profile" asp-action="Edit" class="btn btn-outline" style="justify-content:flex-start;">🧑‍⚕️ Update Medical Profile</a>
        </div>
    </div>
</div>

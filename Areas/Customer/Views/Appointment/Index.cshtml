@using ClinicManagementSystem.Models
@{
    ViewData["Title"] = "My Appointments"; ViewData["Page"] = "Appointments";
    var upcoming = ViewBag.Upcoming as List<Appointment> ?? new();
    var past = ViewBag.Past as List<Appointment> ?? new();
}

<div class="page-header">
    <div><h1>My Appointments</h1></div>
    <a asp-controller="Doctor" asp-action="Index" class="btn btn-primary">📅 Book New Appointment</a>
</div>

<div data-tabs>
    <div class="tabs">
        <button class="tab-btn active" data-tab="upcoming-tab">Upcoming (@upcoming.Count)</button>
        <button class="tab-btn" data-tab="past-tab">Past (@past.Count)</button>
    </div>

    <div class="tab-pane active" id="upcoming-tab">
        @if (!upcoming.Any())
        {
            <div class="empty-state"><div class="empty-icon">📅</div><h3>No upcoming appointments</h3></div>
        }
        else
        {
            <div class="grid grid-2">
                @foreach (var a in upcoming)
                {
                    <div class="card">
                        <div class="card-body">
                            <div class="flex justify-between items-center">
                                <div>
                                    <div class="fw-700">Dr. @a.Doctor?.FullName</div>
                                    <div class="text-muted text-sm">@a.Doctor?.Specialization · @a.Doctor?.Clinic?.Name</div>
                                </div>
                                <span class="badge badge-warning">@a.Status</span>
                            </div>
                            <p class="mt-3 fw-600">🕐 @a.AppointmentDate.ToString("dddd, MMM d, yyyy - h:mm tt")</p>
                            <form asp-action="Cancel" asp-route-id="@a.Id" method="post" data-confirm="Cancel this appointment?" class="mt-3">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm">✖ Cancel</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="tab-pane" id="past-tab">
        @if (!past.Any())
        {
            <div class="empty-state"><div class="empty-icon">🗂️</div><h3>No past appointments yet</h3></div>
        }
        else
        {
            <div class="card">
                <div class="table-wrap">
                    <table class="data-table">
                        <thead><tr><th>Doctor</th><th>Clinic</th><th>Date</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var a in past)
                            {
                                <tr>
                                    <td>Dr. @a.Doctor?.FullName</td>
                                    <td>@a.Doctor?.Clinic?.Name</td>
                                    <td>@a.AppointmentDate.ToString("g")</td>
                                    <td>
                                        @{
                                            var cls = a.Status switch { AppointmentStatus.Completed => "badge-success", AppointmentStatus.Cancelled => "badge-danger", _ => "badge-secondary" };
                                        }
                                        <span class="badge @cls">@a.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

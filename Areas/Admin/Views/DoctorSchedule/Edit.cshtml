@model DoctorScheduleVM
@{ ViewData["Title"] = "Edit Schedule"; ViewData["Page"] = "Schedules"; var doctors = ViewBag.Doctors as List<Doctor> ?? new(); }

<div class="page-header">
    <div><h1>Edit Schedule</h1><div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Dashboard</a><span>/</span><a asp-action="Index">Schedules</a><span>/</span><span>Edit</span></div></div>
</div>

<div class="card" style="max-width:640px;">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@ViewBag.ScheduleId" method="post">
            @Html.AntiForgeryToken()
            @if (!ViewData.ModelState.IsValid) { <div class="alert alert-danger">@foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors)) { <div>@e.ErrorMessage</div> }</div> }

            <div class="form-group"><label class="form-label">Doctor</label>
                <select asp-for="DoctorId" class="form-select">
                    @foreach (var d in doctors) { <option value="@d.Id">Dr. @d.FullName — @d.Specialization</option> }
                </select>
            </div>

            <div class="form-group"><label class="form-label">Day of Week</label>
                <select asp-for="DayOfWeek" class="form-select">
                    @foreach (var day in Enum.GetValues<DayOfWeek>()) { <option value="@day">@day</option> }
                </select>
            </div>

            <div class="form-row">
                <div class="form-group"><label class="form-label">Start Time</label><input asp-for="StartTime" type="time" class="form-control" /></div>
                <div class="form-group"><label class="form-label">End Time</label><input asp-for="EndTime" type="time" class="form-control" /></div>
            </div>

            <div class="form-group"><label class="form-label">Slot Duration (minutes)</label><input asp-for="SlotDurationMinutes" type="number" class="form-control" /></div>

            <div class="flex gap-3 mt-4">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@model DoctorVM
@{ ViewData["Title"] = "Add Doctor"; ViewData["Page"] = "Doctors"; var clinics = ViewBag.Clinics as List<Clinic> ?? new(); }

<div class="page-header">
    <div><h1>Add Doctor</h1><div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Dashboard</a><span>/</span><a asp-action="Index">Doctors</a><span>/</span><span>Add</span></div></div>
</div>

<div class="card" style="max-width:760px;">
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            @if (!ViewData.ModelState.IsValid) { <div class="alert alert-danger">@foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors)) { <div>@e.ErrorMessage</div> }</div> }

            <div class="form-group">
                <label class="form-label">Photo</label>
                <input type="file" name="Image" class="form-control" accept="image/*" />
            </div>

            <div class="form-row">
                <div class="form-group"><label class="form-label">Full Name <span class="req">*</span></label><input asp-for="FullName" class="form-control" /></div>
                <div class="form-group"><label class="form-label">Specialization <span class="req">*</span></label><input asp-for="Specialization" class="form-control" /></div>
            </div>

            <div class="form-row">
                <div class="form-group"><label class="form-label">Clinic <span class="req">*</span></label>
                    <select asp-for="ClinicId" class="form-select">
                        <option value="">-- Select Clinic --</option>
                        @foreach (var c in clinics) { <option value="@c.Id">@c.Name</option> }
                    </select>
                </div>
                <div class="form-group"><label class="form-label">Consultation Fee <span class="req">*</span></label><input asp-for="ConsultationFee" type="number" step="0.01" class="form-control" /></div>
            </div>

            <div class="form-row">
                <div class="form-group"><label class="form-label">Phone <span class="req">*</span></label><input asp-for="PhoneNumber" class="form-control" /></div>
                <div class="form-group"><label class="form-label">Email</label><input asp-for="Email" class="form-control" /></div>
            </div>

            <div class="form-group"><label class="form-label">Bio</label><textarea asp-for="Bio" class="form-control"></textarea></div>

            <div class="form-group"><label class="form-label">Linked Login Account (optional)</label>
                <select name="ApplicationUserId" class="form-select">
                    <option value="">-- None --</option>
                    @foreach (var u in ViewBag.Users as List<ApplicationUser> ?? new()) { <option value="@u.Id">@u.FullName (@u.Email)</option> }
                </select>
                <div class="form-hint">Optional: link this doctor record to a user account with the "Doctor" role so they could log in later.</div>
            </div>

            <div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label class="form-label" style="margin:0;">Active</label></div>

            <div class="flex gap-3 mt-4">
                <button type="submit" class="btn btn-primary">Create Doctor</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

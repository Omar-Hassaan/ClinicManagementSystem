@model ClinicVM
@{ ViewData["Title"] = "Add Clinic"; ViewData["Page"] = "Clinics"; }

<div class="page-header">
    <div>
        <h1>Add Clinic</h1>
        <div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Dashboard</a><span>/</span><a asp-action="Index">Clinics</a><span>/</span><span>Add</span></div>
    </div>
</div>

<div class="card" style="max-width:720px;">
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">@foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors)) { <div>@e.ErrorMessage</div> }</div>
            }

            <div class="form-group">
                <label class="form-label">Clinic Image</label>
                <input type="file" name="Image" class="form-control" accept="image/*" />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Name <span class="req">*</span></label>
                    <input asp-for="Name" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label">Specialization <span class="req">*</span></label>
                    <input asp-for="Specialization" class="form-control" placeholder="e.g. General, Dental, Pediatrics" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Address <span class="req">*</span></label>
                    <input asp-for="Address" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label">Phone <span class="req">*</span></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control"></textarea>
            </div>

            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label class="form-label" style="margin:0;">Active</label>
            </div>

            <div class="flex gap-3 mt-4">
                <button type="submit" class="btn btn-primary">Create Clinic</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

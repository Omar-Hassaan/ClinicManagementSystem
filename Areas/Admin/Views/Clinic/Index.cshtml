@model IEnumerable<Clinic>
@{ ViewData["Title"] = "Clinics"; ViewData["Page"] = "Clinics"; }

<div class="page-header">
    <div>
        <h1>Clinics</h1>
        <div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Dashboard</a><span>/</span><span>Clinics</span></div>
    </div>
    <a asp-action="Create" class="btn btn-primary">➕ Add Clinic</a>
</div>

<div class="grid grid-3">
    @if (!Model.Any())
    {
        <div class="empty-state" style="grid-column:1/-1;"><div class="empty-icon">🏥</div><h3>No clinics yet</h3></div>
    }
    @foreach (var c in Model)
    {
        <div class="card">
            @if (!string.IsNullOrEmpty(c.ImageUrl))
            {
                <img src="@c.ImageUrl" style="width:100%;height:160px;object-fit:cover;" alt="@c.Name" />
            }
            else
            {
                <div style="width:100%;height:160px;background:linear-gradient(135deg,#dbeafe,#e0e7ff);display:flex;align-items:center;justify-content:center;font-size:50px;">🏥</div>
            }
            <div class="card-body">
                <div class="flex justify-between items-center">
                    <h3 class="fw-700">@c.Name</h3>
                    @if (c.IsActive) { <span class="badge badge-success">Active</span> } else { <span class="badge badge-secondary">Inactive</span> }
                </div>
                <div class="text-muted text-sm mt-1">@c.Specialization</div>
                <div class="text-muted text-sm mt-2">📍 @c.Address</div>
                <div class="text-muted text-sm">📞 @c.PhoneNumber</div>
                <div class="flex gap-2 mt-4">
                    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-outline btn-sm">👁️ View</a>
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline btn-sm">✏️ Edit</a>
                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" data-confirm="Delete this clinic?">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm">🗑️</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

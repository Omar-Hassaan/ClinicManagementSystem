@model AssignRolesVM
@{ ViewData["Title"] = "Manage Roles"; ViewData["Page"] = "Users"; }

<div class="page-header">
    <div>
        <h1>Manage Roles</h1>
        <div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Dashboard</a><span>/</span><a asp-action="Index">Users</a><span>/</span><span>Roles</span></div>
    </div>
</div>

<div class="card" style="max-width:520px;">
    <div class="card-body">
        <h3 class="mb-4">User: @Model.UserName</h3>
        <form asp-action="ManageRoles" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="UserName" />

            @foreach (var r in Model.AllRoles)
            {
                <div class="form-check">
                    <input type="checkbox" name="SelectedRoles" value="@r" id="r_@r" class="form-check-input"
                           checked="@(Model.SelectedRoles.Contains(r))" />
                    <label for="r_@r">@r</label>
                </div>
            }

            <div class="flex gap-3 mt-4">
                <button type="submit" class="btn btn-primary">Save Roles</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@model UserEditVM
@{ ViewData["Title"] = "Edit User"; ViewData["Page"] = "Users"; }

<div class="page-header">
    <div>
        <h1>Edit User</h1>
        <div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Dashboard</a><span>/</span><a asp-action="Index">Users</a><span>/</span><span>Edit</span></div>
    </div>
</div>

<div class="card" style="max-width:720px;">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors)) { <div>@err.ErrorMessage</div> }
                </div>
            }

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Full Name</label>
                    <input asp-for="FullName" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Phone Number</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label">Address</label>
                    <input asp-for="Address" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">New Password (leave blank to keep current)</label>
                <input asp-for="NewPassword" class="form-control" />
            </div>

            <div class="flex gap-3 mt-4">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

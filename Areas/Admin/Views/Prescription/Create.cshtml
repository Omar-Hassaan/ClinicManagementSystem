@model PrescriptionVM
@{ ViewData["Title"] = "New Prescription"; ViewData["Page"] = "Prescriptions"; var records = ViewBag.Records as List<MedicalRecord> ?? new(); }

<div class="page-header">
    <div><h1>New Prescription</h1><div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Dashboard</a><span>/</span><a asp-action="Index">Prescriptions</a><span>/</span><span>New</span></div></div>
</div>

<div class="card" style="max-width:680px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            @if (!ViewData.ModelState.IsValid) { <div class="alert alert-danger">@foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors)) { <div>@e.ErrorMessage</div> }</div> }

            <div class="form-group"><label class="form-label">Medical Record <span class="req">*</span></label>
                <select asp-for="MedicalRecordId" class="form-select">
                    <option value="">-- Select Medical Record --</option>
                    @foreach (var r in records) { <option value="@r.Id" selected="@(r.Id == Model.MedicalRecordId)">#@r.Id — @r.Patient.FullName — @r.Diagnosis</option> }
                </select>
            </div>

            <div class="form-row">
                <div class="form-group"><label class="form-label">Medicine Name <span class="req">*</span></label><input asp-for="MedicineName" class="form-control" /></div>
                <div class="form-group"><label class="form-label">Dosage <span class="req">*</span></label><input asp-for="Dosage" class="form-control" placeholder="e.g. 500mg" /></div>
            </div>

            <div class="form-row">
                <div class="form-group"><label class="form-label">Frequency <span class="req">*</span></label><input asp-for="Frequency" class="form-control" placeholder="e.g. Twice a day" /></div>
                <div class="form-group"><label class="form-label">Duration (days) <span class="req">*</span></label><input asp-for="DurationDays" type="number" class="form-control" /></div>
            </div>

            <div class="form-group"><label class="form-label">Start Date <span class="req">*</span></label><input asp-for="StartDate" type="date" class="form-control" /></div>
            <div class="form-group"><label class="form-label">Instructions</label><textarea asp-for="Instructions" class="form-control"></textarea></div>

            <div class="flex gap-3 mt-4">
                <button type="submit" class="btn btn-primary">Create Prescription</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

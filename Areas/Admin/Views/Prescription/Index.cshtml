@model IEnumerable<Prescription>
@{ ViewData["Title"] = "Prescriptions"; ViewData["Page"] = "Prescriptions"; }

<div class="page-header">
    <div><h1>Prescriptions</h1><div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Dashboard</a><span>/</span><span>Prescriptions</span></div></div>
    <a asp-action="Create" class="btn btn-primary">➕ New Prescription</a>
</div>

<div class="card">
    <div class="table-wrap">
        <table class="data-table">
            <thead><tr><th>Patient</th><th>Medicine</th><th>Dosage</th><th>Frequency</th><th>Duration</th><th>Actions</th></tr></thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6"><div class="empty-state"><div class="empty-icon">💊</div><h3>No prescriptions yet</h3></div></td></tr>
                }
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.MedicalRecord?.Patient?.FullName</td>
                        <td class="fw-600">@p.MedicineName</td>
                        <td>@p.Dosage</td>
                        <td>@p.Frequency</td>
                        <td>@p.DurationDays days</td>
                        <td>
                            <div class="flex gap-2">
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline btn-sm">✏️</a>
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post" data-confirm="Delete this prescription?">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">🗑️</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

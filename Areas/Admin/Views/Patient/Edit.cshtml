@model PatientVM
@{ ViewData["Title"] = "Edit Patient"; ViewData["Page"] = "Patients"; }

<div class="page-header">
    <div><h1>Edit Patient</h1><div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Dashboard</a><span>/</span><a asp-action="Index">Patients</a><span>/</span><span>Edit</span></div></div>
</div>

<div class="card" style="max-width:720px;">
    <div class="card-body">
        <p class="text-muted mb-4">User: <strong>@ViewBag.UserName</strong></p>

        <form asp-action="Edit" asp-route-id="@ViewBag.PatientId" method="post">
            @Html.AntiForgeryToken()
            @if (!ViewData.ModelState.IsValid) { <div class="alert alert-danger">@foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors)) { <div>@e.ErrorMessage</div> }</div> }

            <div class="form-row">
                <div class="form-group"><label class="form-label">Gender</label>
                    <select asp-for="Gender" class="form-select"><option>Male</option><option>Female</option></select>
                </div>
                <div class="form-group"><label class="form-label">Age</label><input asp-for="Age" type="number" class="form-control" /></div>
            </div>

            <div class="form-row">
                <div class="form-group"><label class="form-label">Date of Birth</label><input asp-for="DateOfBirth" type="date" class="form-control" /></div>
                <div class="form-group"><label class="form-label">Blood Type</label>
                    <select asp-for="BloodType" class="form-select">
                        @foreach (var bt in new[]{"A+","A-","B+","B-","AB+","AB-","O+","O-"}) { <option value="@bt">@bt</option> }
                    </select>
                </div>
            </div>

            <div class="form-group"><label class="form-label">Allergies</label><textarea asp-for="Allergies" class="form-control"></textarea></div>
            <div class="form-group"><label class="form-label">Chronic Diseases</label><textarea asp-for="ChronicDiseases" class="form-control"></textarea></div>

            <div class="form-row">
                <div class="form-group"><label class="form-label">Emergency Contact Name</label><input asp-for="EmergencyContactName" class="form-control" /></div>
                <div class="form-group"><label class="form-label">Emergency Contact Phone</label><input asp-for="EmergencyContactPhone" class="form-control" /></div>
            </div>

            <div class="flex gap-3 mt-4">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

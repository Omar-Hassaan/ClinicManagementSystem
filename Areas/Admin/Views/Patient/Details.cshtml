@model Patient
@{ ViewData["Title"] = Model.FullName; ViewData["Page"] = "Patients"; }

<div class="page-header">
    <div><h1>@Model.FullName</h1><div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Dashboard</a><span>/</span><a asp-action="Index">Patients</a><span>/</span><span>@Model.FullName</span></div></div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">✏️ Edit</a>
</div>

<div class="grid grid-2 mb-6">
    <div class="card">
        <div class="card-header"><h5>ℹ️ Patient Info</h5></div>
        <div class="card-body">
            <div class="grid grid-2">
                <div><div class="text-muted text-sm">Email</div><div class="fw-600">@Model.ApplicationUser?.Email</div></div>
                <div><div class="text-muted text-sm">Gender</div><div class="fw-600">@Model.Gender</div></div>
                <div><div class="text-muted text-sm">Age</div><div class="fw-600">@Model.Age</div></div>
                <div><div class="text-muted text-sm">Blood Type</div><div class="fw-600">@(Model.BloodType ?? "—")</div></div>
                <div><div class="text-muted text-sm">DOB</div><div class="fw-600">@Model.DateOfBirth.ToString("MMM d, yyyy")</div></div>
                <div><div class="text-muted text-sm">Emergency Contact</div><div class="fw-600">@Model.EmergencyContactName @(Model.EmergencyContactPhone != null ? $"({Model.EmergencyContactPhone})" : "")</div></div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Allergies)) { <div class="mt-4"><div class="text-muted text-sm">Allergies</div><p>@Model.Allergies</p></div> }
            @if (!string.IsNullOrEmpty(Model.ChronicDiseases)) { <div class="mt-4"><div class="text-muted text-sm">Chronic Diseases</div><p>@Model.ChronicDiseases</p></div> }
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h5>📋 Appointment History (@Model.Appointments.Count)</h5></div>
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Date</th><th>Status</th></tr></thead>
                <tbody>
                    @if (!Model.Appointments.Any()) { <tr><td colspan="2" class="text-center text-muted">No appointments yet.</td></tr> }
                    @foreach (var a in Model.Appointments.OrderByDescending(a => a.AppointmentDate))
                    {
                        <tr><td>@a.AppointmentDate.ToString("g")</td><td><span class="badge badge-info">@a.Status</span></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model MedicalRecordVM
@{ ViewData["Title"] = "Edit Medical Record"; ViewData["Page"] = "MedicalRecords"; }

<div class="page-header">
    <div><h1>Edit Medical Record</h1><div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Dashboard</a><span>/</span><a asp-action="Index">Medical Records</a><span>/</span><span>Edit</span></div></div>
</div>

<div class="card" style="max-width:760px;">
    <div class="card-body">
        <p class="text-muted mb-4">Appointment: <strong>@ViewBag.AppointmentLabel</strong></p>

        <form asp-action="Edit" asp-route-id="@ViewBag.RecordId" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="AppointmentId" />
            <input type="hidden" asp-for="PatientId" />
            @if (!ViewData.ModelState.IsValid) { <div class="alert alert-danger">@foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors)) { <div>@e.ErrorMessage</div> }</div> }

            <div class="form-group"><label class="form-label">Diagnosis</label><input asp-for="Diagnosis" class="form-control" /></div>
            <div class="form-group"><label class="form-label">Symptoms</label><textarea asp-for="Symptoms" class="form-control"></textarea></div>
            <div class="form-group"><label class="form-label">Treatment Plan</label><textarea asp-for="TreatmentPlan" class="form-control"></textarea></div>
            <div class="form-group"><label class="form-label">Doctor Notes</label><textarea asp-for="DoctorNotes" class="form-control"></textarea></div>

            <div class="form-row">
                <div class="form-group"><label class="form-label">Weight (kg)</label><input asp-for="Weight" type="number" step="0.1" class="form-control" /></div>
                <div class="form-group"><label class="form-label">Height (cm)</label><input asp-for="Height" type="number" step="0.1" class="form-control" /></div>
                <div class="form-group"><label class="form-label">Temperature (°C)</label><input asp-for="Temperature" type="number" step="0.1" class="form-control" /></div>
                <div class="form-group"><label class="form-label">Blood Pressure</label><input asp-for="BloodPressure" class="form-control" /></div>
            </div>

            <div class="flex gap-3 mt-4">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

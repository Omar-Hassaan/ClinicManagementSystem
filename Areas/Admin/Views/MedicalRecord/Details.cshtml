@model MedicalRecord
@{ ViewData["Title"] = "Medical Record"; ViewData["Page"] = "MedicalRecords"; }

<div class="page-header">
    <div><h1>Medical Record #@Model.Id</h1><div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Dashboard</a><span>/</span><a asp-action="Index">Medical Records</a><span>/</span><span>Details</span></div></div>
    <div class="flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">✏️ Edit</a>
        <a asp-controller="Prescription" asp-action="Create" asp-route-recordId="@Model.Id" class="btn btn-success">💊 Add Prescription</a>
    </div>
</div>

<div class="grid grid-2 mb-6">
    <div class="card">
        <div class="card-header"><h5>ℹ️ Details</h5></div>
        <div class="card-body">
            <div class="grid grid-2">
                <div><div class="text-muted text-sm">Patient</div><div class="fw-600">@Model.Patient?.FullName</div></div>
                <div><div class="text-muted text-sm">Doctor</div><div class="fw-600">Dr. @Model.Appointment?.Doctor?.FullName</div></div>
                <div><div class="text-muted text-sm">Date</div><div class="fw-600">@Model.CreatedAt.ToString("MMM d, yyyy")</div></div>
                <div><div class="text-muted text-sm">Diagnosis</div><div class="fw-600">@Model.Diagnosis</div></div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Symptoms)) { <div class="mt-3"><div class="text-muted text-sm">Symptoms</div><p>@Model.Symptoms</p></div> }
            @if (!string.IsNullOrEmpty(Model.TreatmentPlan)) { <div class="mt-3"><div class="text-muted text-sm">Treatment Plan</div><p>@Model.TreatmentPlan</p></div> }
            @if (!string.IsNullOrEmpty(Model.DoctorNotes)) { <div class="mt-3"><div class="text-muted text-sm">Doctor Notes</div><p>@Model.DoctorNotes</p></div> }
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h5>💓 Vitals</h5></div>
        <div class="card-body">
            <div class="grid grid-2">
                <div><div class="text-muted text-sm">Weight</div><div class="fw-600">@(Model.Weight != null ? $"{Model.Weight} kg" : "—")</div></div>
                <div><div class="text-muted text-sm">Height</div><div class="fw-600">@(Model.Height != null ? $"{Model.Height} cm" : "—")</div></div>
                <div><div class="text-muted text-sm">Temperature</div><div class="fw-600">@(Model.Temperature != null ? $"{Model.Temperature} °C" : "—")</div></div>
                <div><div class="text-muted text-sm">Blood Pressure</div><div class="fw-600">@(Model.BloodPressure ?? "—")</div></div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><h5>💊 Prescriptions (@Model.Prescriptions.Count)</h5></div>
    <div class="table-wrap">
        <table class="data-table">
            <thead><tr><th>Medicine</th><th>Dosage</th><th>Frequency</th><th>Duration</th></tr></thead>
            <tbody>
                @if (!Model.Prescriptions.Any()) { <tr><td colspan="4" class="text-center text-muted">No prescriptions yet.</td></tr> }
                @foreach (var p in Model.Prescriptions)
                {
                    <tr><td>@p.MedicineName</td><td>@p.Dosage</td><td>@p.Frequency</td><td>@p.DurationDays days</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

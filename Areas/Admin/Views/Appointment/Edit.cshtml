@model AppointmentVM
@{ ViewData["Title"] = "Edit Appointment"; ViewData["Page"] = "Appointments";
   var doctors = ViewBag.Doctors as List<Doctor> ?? new(); var patients = ViewBag.Patients as List<Patient> ?? new(); }

<div class="page-header">
    <div><h1>Edit Appointment</h1><div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Dashboard</a><span>/</span><a asp-action="Index">Appointments</a><span>/</span><span>Edit</span></div></div>
</div>

<div class="card" style="max-width:640px;">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@ViewBag.AppointmentId" method="post">
            @Html.AntiForgeryToken()
            @if (!ViewData.ModelState.IsValid) { <div class="alert alert-danger">@foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors)) { <div>@e.ErrorMessage</div> }</div> }

            <div class="form-group"><label class="form-label">Doctor</label>
                <select asp-for="DoctorId" class="form-select">
                    @foreach (var d in doctors) { <option value="@d.Id">Dr. @d.FullName — @d.Specialization</option> }
                </select>
            </div>

            <div class="form-group"><label class="form-label">Patient</label>
                <select asp-for="PatientId" class="form-select">
                    @foreach (var p in patients) { <option value="@p.Id">@p.FullName</option> }
                </select>
            </div>

            <div class="form-group"><label class="form-label">Date & Time</label><input asp-for="AppointmentDate" type="datetime-local" class="form-control" /></div>

            <div class="form-group"><label class="form-label">Status</label>
                <select asp-for="Status" class="form-select">
                    @foreach (var s in Enum.GetValues<AppointmentStatus>()) { <option value="@s">@s</option> }
                </select>
            </div>

            <div class="form-group"><label class="form-label">Notes</label><textarea asp-for="Notes" class="form-control"></textarea></div>

            <div class="flex gap-3 mt-4">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

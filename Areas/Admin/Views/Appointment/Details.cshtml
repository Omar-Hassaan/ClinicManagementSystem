@model Appointment
@{ ViewData["Title"] = "Appointment Details"; ViewData["Page"] = "Appointments"; }

<div class="page-header">
    <div><h1>Appointment #@Model.Id</h1><div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Dashboard</a><span>/</span><a asp-action="Index">Appointments</a><span>/</span><span>Details</span></div></div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">✏️ Edit</a>
</div>

<div class="card">
    <div class="card-body">
        <div class="grid grid-2">
            <div><div class="text-muted text-sm">Patient</div><div class="fw-600">@Model.Patient?.FullName</div></div>
            <div><div class="text-muted text-sm">Doctor</div><div class="fw-600">Dr. @Model.Doctor?.FullName</div></div>
            <div><div class="text-muted text-sm">Date</div><div class="fw-600">@Model.AppointmentDate.ToString("MMM d, yyyy - h:mm tt")</div></div>
            <div><div class="text-muted text-sm">Status</div><span class="badge badge-info">@Model.Status</span></div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Notes)) { <div class="mt-4"><div class="text-muted text-sm">Notes</div><p>@Model.Notes</p></div> }

        @if (Model.MedicalRecord != null)
        {
            <div class="mt-6">
                <h6 class="fw-600 mb-2">📄 Linked Medical Record</h6>
                <a asp-controller="MedicalRecord" asp-action="Details" asp-route-id="@Model.MedicalRecord.Id" class="btn btn-outline btn-sm">View Record</a>
            </div>
        }
    </div>
</div>
